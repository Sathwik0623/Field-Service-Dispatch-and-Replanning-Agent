# ==============================================================================
# Field Service Dispatch and Replanning Agent - Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
DEBUG=True
PROJECT_NAME="Field Service Dispatch and Replanning Agent"
VERSION=0.1.0
API_V1_STR=/api/v1
PORT=8000

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./field_service.db
# Render PostgreSQL / Docker PostgreSQL (Render provides postgres:// or postgresql:// connection strings):
# DATABASE_URL=postgresql://field_ops:field_ops_password@postgres:5432/field_service_db

# Frontend Configuration (Render Static Site / Local Vite)
VITE_API_BASE_URL=http://localhost:8000
# Production Render example:
# VITE_API_BASE_URL=https://your-backend-service.onrender.com

# CORS Configuration (Comma separated list or JSON array string)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:80"]
# Production Render example:
# CORS_ORIGINS=["https://your-frontend-site.onrender.com","http://localhost:5173"]

# AI / LLM Provider Configuration
# Note: Do NOT add real API keys to repository or version control!
# Omit OPENAI_API_KEY to activate zero-dependency MockAIProvider development fallback.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
